[resource]
script = ExtResource("1")
id = &"first_catch_aether_nadir"
trigger_id = &"on_first_catch_aether_nadir"
text = "An aether-nadir. Whatever this is, it is the bottom of something — and you have, somehow, reached it. The Synod prepares its citation now."
