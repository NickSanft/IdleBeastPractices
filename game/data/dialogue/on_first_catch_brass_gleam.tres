[ext_resource type="Script" path="res://game/resources/dialogue_line_resource.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"first_catch_brass_gleam"
trigger_id = &"on_first_catch_brass_gleam"
text = "A brass gleamer. Polishing-cloth on the left, polishing-cloth on the right; the creature is, in a word, gilt. In a longer and more honest word: ostentatious."
mood = &"smug"
weight = 1.0
max_uses = 1
