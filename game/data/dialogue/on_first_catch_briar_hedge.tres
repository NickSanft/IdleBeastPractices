script = ExtResource("1")
id = &"first_catch_briar_hedge"
trigger_id = &"on_first_catch_briar_hedge"
text = "A briar-hedge. The thorns are decorative; the hedge is not. I once spent a fortnight in one. The Synod considered it a sabbatical."
