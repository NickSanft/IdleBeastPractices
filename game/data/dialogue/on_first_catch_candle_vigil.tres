[ext_resource type="Script" path="res://game/resources/dialogue_line_resource.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"first_catch_candle_vigil"
trigger_id = &"on_first_catch_candle_vigil"
text = "A candle-vigil. They keep watch over things that have, frankly, never asked. The Synod respects the tradition. I, for the record, do not."
mood = &"begrudging"
weight = 1.0
max_uses = 1
