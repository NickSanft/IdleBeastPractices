[ext_resource type="Script" path="res://game/resources/dialogue_line_resource.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"first_catch_cipher_whisper"
trigger_id = &"on_first_catch_cipher_whisper"
text = "A cipher-whisper. They speak in the spaces between meanings. The Synod has decoded three; the rest are, in a word, ongoing. The word is unsatisfactory."
mood = &"begrudging"
weight = 1.0
max_uses = 1
