[ext_resource type="Script" path="res://game/resources/dialogue_line_resource.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"first_catch_gossamer_knot"
trigger_id = &"on_first_catch_gossamer_knot"
text = "A gossamer-knot. Silk wound around silk wound around the part where you used to keep your patience. The Synod has stopped untying them — purely, it claims, on principle."
mood = &"weary"
weight = 1.0
max_uses = 1
