[ext_resource type="Script" path="res://game/resources/dialogue_line_resource.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"first_catch_mirror_refract"
trigger_id = &"on_first_catch_mirror_refract"
text = "A mirror-refract. They cast images that are, as a rule, slightly truer than the original. The Synod finds this distasteful. I find it, against my better judgement, illuminating."
mood = &"reverent"
weight = 1.0
max_uses = 1
