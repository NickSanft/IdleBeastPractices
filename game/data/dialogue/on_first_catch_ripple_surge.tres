[ext_resource type="Script" path="res://game/resources/dialogue_line_resource.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"first_catch_ripple_surge"
trigger_id = &"on_first_catch_ripple_surge"
text = "A ripple-surge. Water with intent, which is the most ill-mannered configuration of water. Bring a towel; do not bring etiquette, it will mock you."
mood = &"smug"
weight = 1.0
max_uses = 1
