[resource]
default_base_scale = 1.0
default_font = ExtResource("1_body")
default_font_size = 16

Button/colors/font_color = Color(0.31, 0.22, 0.13, 1)
Button/colors/font_hover_color = Color(0.10, 0.07, 0.05, 1)
Button/colors/font_pressed_color = Color(0.10, 0.07, 0.05, 1)
Button/colors/font_disabled_color = Color(0.46, 0.34, 0.20, 0.6)
Button/colors/font_focus_color = Color(0.10, 0.07, 0.05, 1)
Button/font_sizes/font_size = 16
Button/styles/normal = SubResource("sb_button_normal")
Button/styles/hover = SubResource("sb_button_hover")
Button/styles/pressed = SubResource("sb_button_pressed")
Button/styles/disabled = SubResource("sb_button_disabled")
Button/styles/focus = SubResource("sb_button_focus")

Label/colors/font_color = Color(0.31, 0.22, 0.13, 1)
Label/colors/font_shadow_color = Color(0, 0, 0, 0)
Label/font_sizes/font_size = 16

PanelContainer/styles/panel = SubResource("sb_panel")

ProgressBar/styles/background = SubResource("sb_progress_bg")
ProgressBar/styles/fill = SubResource("sb_progress_fill")
ProgressBar/colors/font_color = Color(0.10, 0.07, 0.05, 1)
ProgressBar/font_sizes/font_size = 13

LineEdit/colors/font_color = Color(0.31, 0.22, 0.13, 1)
LineEdit/colors/font_placeholder_color = Color(0.46, 0.34, 0.20, 0.6)
LineEdit/colors/caret_color = Color(0.65, 0.16, 0.22, 1)
LineEdit/colors/selection_color = Color(0.72, 0.55, 0.20, 0.4)
LineEdit/font_sizes/font_size = 16
LineEdit/styles/normal = SubResource("sb_lineedit_normal")
LineEdit/styles/focus = SubResource("sb_lineedit_focus")

PopupPanel/styles/panel = SubResource("sb_popup")

; RichTextLabel inherits its body color from `default_color`, NOT from
; Label's `font_color`. Without this entry, RTLs render white — which
; vanishes against the parchment bubble Peniber's overlay sits in.
; Applies to: narrator_overlay, prestige_view summary, crafting_view
; recipe lines, welcome_back_dialog body.
RichTextLabel/colors/default_color = Color(0.10, 0.07, 0.05, 1)
RichTextLabel/font_sizes/normal_font_size = 16

CheckBox/colors/font_color = Color(0.31, 0.22, 0.13, 1)
CheckBox/colors/font_hover_color = Color(0.10, 0.07, 0.05, 1)
CheckBox/colors/font_pressed_color = Color(0.10, 0.07, 0.05, 1)
CheckBox/font_sizes/font_size = 16

OptionButton/colors/font_color = Color(0.31, 0.22, 0.13, 1)
OptionButton/colors/font_hover_color = Color(0.10, 0.07, 0.05, 1)
OptionButton/font_sizes/font_size = 16
OptionButton/styles/normal = SubResource("sb_button_normal")
OptionButton/styles/hover = SubResource("sb_button_hover")
OptionButton/styles/pressed = SubResource("sb_button_pressed")
OptionButton/styles/disabled = SubResource("sb_button_disabled")
OptionButton/styles/focus = SubResource("sb_button_focus")

; Heading variation: scenes that want the display face apply the
; "Heading" theme_type_variation to a Label.
Heading/base_type = &"Label"
Heading/colors/font_color = Color(0.10, 0.07, 0.05, 1)
Heading/font_sizes/font_size = 26
Heading/fonts/font = ExtResource("2_display")

; Subhead: same display face, smaller.
Subhead/base_type = &"Label"
Subhead/colors/font_color = Color(0.31, 0.22, 0.13, 1)
Subhead/font_sizes/font_size = 18
Subhead/fonts/font = ExtResource("2_display")
