; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[admob]

rewarded_unit_id=""
use_test_ad_units=true

[application]

config/name="IdleBeastPractices"
config/description="An idle monster-catching game with three currency layers, a pet auto-battler, a bestiary, monster-part crafting, and a grumpy in-world narrator."
run/main_scene="res://game/scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Settings="*res://game/autoloads/settings.gd"
EventBus="*res://game/autoloads/event_bus.gd"
SaveManager="*res://game/autoloads/save_manager.gd"
TimeManager="*res://game/autoloads/time_manager.gd"
GameState="*res://game/autoloads/game_state.gd"
AudioManager="*res://game/autoloads/audio_manager.gd"
Narrator="*res://game/autoloads/narrator.gd"
AdsManager="*res://game/autoloads/ads_manager.gd"
GodotPlayGameServices="*uid://bin06y213u26g"
CloudSyncManager="*res://game/autoloads/cloud_sync_manager.gd"
TutorialState="*res://game/autoloads/tutorial_state.gd"
Achievements="*res://game/autoloads/achievements.gd"
QuestLog="*res://game/autoloads/quest_log.gd"
DeviceLayout="*res://game/autoloads/device_layout.gd"
HapticManager="*res://game/autoloads/haptic_manager.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
; Phase 13c.3 — was "keep_width" pre-v0.14.3, which locked the
; design width to 720 dp in every orientation. In landscape the
; viewport became 720×405 logical, so the HBox rail+content
; layout had the same horizontal design space as portrait — just
; squished vertically. "expand" lets the viewport take the device's
; real aspect ratio, so landscape gets a wider design width to lay
; out into. Density compensation is handled by Phase-13b's
; DeviceLayout autoload, which sets `content_scale_factor` from the
; detected DPI bucket so canvas_items don't shrink on dense screens.
window/stretch/aspect="expand"
; Phase 13c.1 — orientation unlocked for landscape support.
; 6 = SCREEN_SENSOR (auto-rotate based on device sensor; excludes
; reverse-portrait by default, which is what idle games want).
; Per the v0.8.x notes the integer enum is required — string
; "sensor" silently falls back to landscape.
window/handheld/orientation=6

[dotnet]

project/assembly_name="IdleBeastPractices"

[editor_plugins]

enabled=PackedStringArray("res://addons/admob/plugin.cfg", "res://addons/GodotPlayGameServices/plugin.cfg")

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
